# Include package metadata
include LICENSE
include README.md
include CHANGELOG.rst
include CONTRIBUTING.rst

# Include SQLite database files (auto-updating data)
recursive-include catalogmx/data *.sqlite3 *.db

# Include type stubs
include catalogmx/py.typed

# Exclude compiled files and cache
global-exclude *.py[cod] __pycache__ *.so *.dylib
global-exclude .DS_Store
global-exclude *.swp
