{
  "name": "catalogmx",
  "version": "0.6.0",
  "description": "Enterprise Mexican library: validators, generators, tax calculators, CFDI tooling and official SAT/INEGI/SEPOMEX/Banxico/IFT/CNBV catalogs. Works in Node.js and browsers.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./validators": {
      "types": "./dist/validators/index.d.ts",
      "default": "./dist/validators/index.js"
    },
    "./calculators": {
      "types": "./dist/calculators/index.d.ts",
      "default": "./dist/calculators/index.js"
    },
    "./catalogs": {
      "types": "./dist/catalogs/index.d.ts",
      "default": "./dist/catalogs/index.js"
    },
    "./catalogs/preload": {
      "types": "./dist/catalogs/preload.d.ts",
      "default": "./dist/catalogs/preload.js"
    },
    "./cfdi": {
      "types": "./dist/cfdi/index.d.ts",
      "default": "./dist/cfdi/index.js"
    },
    "./fiscal": {
      "types": "./dist/fiscal/index.d.ts",
      "default": "./dist/fiscal/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "default": "./dist/utils/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/types/index.js"
    }
  },
  "scripts": {
    "build": "npm run check:catalog-data && tsc && node scripts/copy-shared-data.mjs",
    "check:catalog-data": "node scripts/generate-bundled-catalog-data.mjs --check",
    "clean": "rm -rf dist",
    "generate:catalog-data": "node scripts/generate-bundled-catalog-data.mjs",
    "prebuild": "npm run clean",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test",
    "validate": "npm run format:check && npm run typecheck && npm run lint"
  },
  "keywords": [
    "mexico",
    "mexican",
    "rfc",
    "curp",
    "clabe",
    "nss",
    "sat",
    "cfdi",
    "validator",
    "validation",
    "catalogs",
    "generators",
    "calculators",
    "banxico",
    "inegi",
    "sepomex",
    "imss",
    "ift",
    "cnbv",
    "conapo",
    "postal-codes",
    "geographic-data",
    "tax",
    "financial",
    "browser",
    "isomorphic"
  ],
  "author": {
    "name": "Luis Fernando Barrera",
    "email": "luisfernando@informind.com"
  },
  "license": "BSD-2-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openbancor/catalogmx.git",
    "directory": "packages/typescript"
  },
  "bugs": {
    "url": "https://github.com/openbancor/catalogmx/issues"
  },
  "homepage": "https://catalogmx.openbancor.com",
  "files": [
    "dist",
    "README.md"
  ],
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "sql.js": "^1.14.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.6.0",
    "libxmljs2": "^0.37.0",
    "xslt-processor": "^2.3.1"
  }
}
